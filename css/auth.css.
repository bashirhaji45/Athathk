:root{--ink:#2B1D14;--wood:#5B3A29;--terra:#A84F2B;--sage:#4E6B50;--cream:#FAF5EC;--sand:#F0E5D2;--mut:#6B5A4B;--err:#B3261E}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;font:16px/1.7 Tajawal,sans-serif;color:var(--ink);background:var(--cream);min-height:100vh}
:focus-visible{outline:3px solid var(--terra);outline-offset:2px}
.a{fill:var(--a)}.b{fill:var(--b)}.w{fill:#5B3A29}.s{fill:#2B1D141F}

/* تخطيط منقسم: لوحة ترحيب + لوحة النموذج */
.page{display:grid;grid-template-columns:1fr 1.05fr;min-height:100vh}
.side{background:linear-gradient(160deg,var(--wood),#7A4A32 60%,var(--terra));color:#fff;padding:40px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}
.side a.logo{color:#fff;font-weight:800;font-size:26px;text-decoration:none}
.side h1{font-size:34px;line-height:1.35;margin:0 0 10px;font-weight:800}
.side p{margin:0;color:#F0DFCB;font-size:17px;max-width:360px}
.side svg.room{width:100%;max-width:400px;margin:24px auto 0;display:block}
.main{display:flex;align-items:center;justify-content:center;padding:32px 20px}
.box{width:100%;max-width:420px}

/* تبديل بين الدخول والتسجيل */
.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--sand);border-radius:16px;padding:5px;margin-bottom:28px}
.seg a{text-align:center;padding:10px;min-height:44px;border-radius:12px;color:var(--mut);text-decoration:none;font-weight:700}
.seg a[aria-current=page]{background:#fff;color:var(--terra);box-shadow:0 2px 8px #5B3A291F}
h2{margin:0 0 4px;font-size:28px;color:var(--wood)}
.lead{margin:0 0 22px;color:var(--mut)}

/* حقول بتسمية عائمة وخلفية ناعمة (بلا حدود تقليدية) */
.fld{position:relative;margin-top:14px}
.fld input{width:100%;height:58px;border:2px solid transparent;border-radius:18px;background:var(--sand);padding:20px 48px 0 48px;font:16px Tajawal,sans-serif;color:var(--ink);transition:.15s}
.fld input:focus{background:#fff;border-color:var(--terra);outline:0;box-shadow:0 0 0 4px #A84F2B1F}
.fld input[aria-invalid=true]{border-color:var(--err);background:#FFF4F2}
.fld label{position:absolute;inset-inline-start:48px;top:17px;color:var(--mut);pointer-events:none;transition:.15s;transform-origin:right}
.fld input:focus+label,.fld input:not(:placeholder-shown)+label{transform:translateY(-11px) scale(.8)}
.fld .ic,.fld .eye{position:absolute;top:0;height:58px;width:44px;display:grid;place-items:center;color:var(--mut)}
.fld .ic{inset-inline-end:2px}
.fld .eye{inset-inline-start:2px;background:none;border:0;cursor:pointer;border-radius:14px}
.fld .eye:hover{color:var(--terra)}
.err{font-size:13px;color:var(--err);margin:4px 8px 0;min-height:0}
.meter{display:flex;gap:6px;align-items:center;margin:8px 8px 0;font-size:13px;color:var(--mut)}
.meter span{flex:1;height:5px;border-radius:3px;background:#E4D6BF}
.meter em{font-style:normal;min-width:48px;text-align:left}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:16px 4px}
.chk{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--mut);cursor:pointer}
.chk input{width:20px;height:20px;margin:2px 0 0;accent-color:var(--terra);flex:none}
.link{color:var(--terra);font-weight:700;text-decoration:none;background:none;border:0;font:700 14px Tajawal,sans-serif;cursor:pointer;min-height:44px}
.btn{width:100%;min-height:54px;border:0;border-radius:18px;background:var(--terra);color:#fff;font:700 17px Tajawal,sans-serif;cursor:pointer;transition:.15s}
.btn:hover{background:#8C3F20}
.ok{background:#DDF3E4;color:#14602B;padding:14px 16px;border-radius:16px;margin-top:16px}
.foot{text-align:center;margin-top:20px;color:var(--mut);font-size:15px}
@media(max-width:820px){.page{grid-template-columns:1fr}.side{padding:22px;min-height:0}.side h1{font-size:24px}.side p,.side svg.room{display:none}.main{padding:24px 16px 40px}}
